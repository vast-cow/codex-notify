
{
  "telegram": {
    "enabled": true,
    "bot_token": "YOUR_TELEGRAM_BOT_TOKEN",
    "chat_id": "YOUR_CHAT_ID"
  },
  "slack": {
    "enabled": true,
    "webhook_url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
  },
  "notification": {
    "title": "Codex CLI",
    "include_project": true,
    "excluded_project_paths": [],
    "min_turn_duration_minutes": 1,
    "skip_active_goals": true,
    "_skip_active_goals_help": "With a zero minimum duration, an initially active goal is checked again after waiting for the turn completion record. Set skip_active_goals to false to disable goal filtering and its wait.",
    "include_input": true,
    "include_output": true,
    "truncate_enabled": true,
    "max_output_length": 140,
    "thread_url_template": "",
    "timeout_seconds": 10
  },
  "app_server": {
    "enabled": false,
    "endpoint": "unix:///tmp/codex-app-server.sock",
    "skip_ephemeral": true,
    "skip_archived": true,
    "timeout_seconds": 1.5,
    "on_lookup_failure": "notify"
  }
}
